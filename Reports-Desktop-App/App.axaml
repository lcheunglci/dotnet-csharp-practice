<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reports_Desktop_App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#111827" />
                    <SolidColorBrush x:Key="AppSubtleTextBrush" Color="#6B7280" />
                    <SolidColorBrush x:Key="AppBgBrush" Color="#F9FAFB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppCardBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="AppSubtleTextBrush" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="AppBgBrush" Color="#1F1F1F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>